// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

model Usuario {
  idUsuario       Int      @id @default(autoincrement())
  nombre          String   @unique
  email           String   @unique
  contrasenaHash  String
  rol             Rol      @default(USUARIO)
  activo          Boolean  @default(true)
  fechaCreado     DateTime @default(now())
  reportes        Reporte[]
  comentarios     Comentario[]
}

enum Rol {
  USUARIO
  ADMIN
  INVESTIGADOR
}

model Zona {
  idZona       Int    @id @default(autoincrement())
  nombre       String
  descripcion  String
  nivelPeligro String
  reportes     Reporte[]
}

model Categoria {
  idCategoria       Int    @id @default(autoincrement())
  nombre       String
  descripcion  String
  reportes     Reporte[]
}

model Reporte {
  idReporte    Int           @id @default(autoincrement())
  titulo       String
  cuerpo       String        @db.Text
  fechaHora    DateTime      @default(now())
  estado       EstadoReporte @default(NO_VERIFICADO)

  idZona       Int
  idUsuario    Int
  idCategoria  Int

  zona         Zona          @relation(fields: [idZona], references: [idZona])
  usuario      Usuario       @relation(fields: [idUsuario], references: [idUsuario])
  categoria    Categoria     @relation(fields: [idCategoria], references: [idCategoria])

  imagenes     ImagenReporte[]
  comentarios     Comentario[]
}

enum EstadoReporte {
  NO_VERIFICADO
  EN_INVESTIGACION
  VERIFICADO
}

model ImagenReporte {
  idImagen   Int     @id @default(autoincrement())
  url        String
  idReporte  Int
  reporte    Reporte @relation(fields: [idReporte], references: [idReporte], onDelete: Cascade)
}

model Comentario {
  idComentario Int      @id @default(autoincrement())
  texto        String   @db.Text
  fechaHora    DateTime @default(now())

  idUsuario    Int
  idReporte    Int

  usuario      Usuario  @relation(fields: [idUsuario], references: [idUsuario])
  reporte      Reporte  @relation(fields: [idReporte], references: [idReporte], onDelete: Cascade)
}
